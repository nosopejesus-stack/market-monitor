# Copia generada por scripts/generate-env.sh -> .env (nunca subir .env a git)
TZ=Europe/Madrid

# Contraseñas (las rellena generate-env.sh)
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
CHATWOOT_DB_PASSWORD=
UMAMI_DB_PASSWORD=
REDIS_PASSWORD=
N8N_ENCRYPTION_KEY=
CHATWOOT_SECRET_KEY_BASE=
UMAMI_APP_SECRET=

# URLs públicas (en el servidor, pon tus dominios con https)
N8N_HOST=localhost
N8N_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
CHATWOOT_URL=http://localhost:3000

# Modelos de Ollama a descargar (separados por espacios)
OLLAMA_MODELS=llama3.2:3b

# ComfyUI: CPU por defecto. Con GPU NVIDIA ver docker-compose.gpu.yml
COMFYUI_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
COMFYUI_DEVICE_FLAG=--cpu
COMFYUI_REF=master

# Versiones (fija versiones concretas en producción)
N8N_VERSION=latest
CHATWOOT_VERSION=latest
OLLAMA_VERSION=latest
UMAMI_VERSION=postgresql-latest
